<simulation mode='static' verbosity='low'>
    <output prefix='min'>
        <properties stride='1' filename='out'>[step, potential{electronvolt}]</properties>
        <trajectory stride='1' filename='pos' cell_units='angstrom' format='xyz'>positions{angstrom}</trajectory>
    </output>
    <total_steps>1000</total_steps>
    <ffsocket name='qm' mode='unix' pbc='False'>
        <address>orca_ase</address>
    </ffsocket>
    <system>
        <initialize nbeads='1'>
            <file mode='xyz' units='angstrom'>water.xyz</file>
            <cell mode='abc' units='angstrom'>[100, 100, 100]</cell>
        </initialize>
        <forces>
            <force forcefield='qm'></force>
        </forces>
        <motion mode='minimize'>
            <optimizer mode='lbfgs'>
                <tolerances>
                    <energy>5e-5</energy>
                    <force>5e-5</force>
                    <position>5e-5</position>
                </tolerances>
            </optimizer>
        </motion>
    </system>
</simulation>