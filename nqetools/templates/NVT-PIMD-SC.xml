<!-- https://github.com/i-pi/pimd-mooc/blob/main/3-advanced-pimd.ipynb -->
<simulation verbosity='low'>
    <output prefix='nvt-pimd-sc'>
        <properties filename='out' stride='100'>[ step, time{picosecond}, conserved{electronvolt}, temperature{kelvin},
            potential{electronvolt}]
        </properties>
        <trajectory filename='pos' stride='200' cell_units="angstrom">positions{angstrom}</trajectory>
        <checkpoint stride='100'/>
    </output>
    <total_steps>100000</total_steps>
    <prng>
        <seed>32415</seed>
    </prng>
    <ffsocket name='driver' mode='unix' pbc='False'>
        <address>driver</address>
    </ffsocket>
    <system>
        <initialize nbeads='1'>
            <file mode='xyz' units='angstrom'>init.xyz</file>
            <cell mode='abc' units='angstrom'>[100 100 100]</cell>
            <velocities mode='thermal' units='kelvin'>300</velocities>
        </initialize>
        <forces>
            <force forcefield='driver'></force>
        </forces>
        <motion mode='dynamics'>
            <dynamics mode='sc' splitting='baoab'>
                <timestep>0.01</timestep>
                <nmts>[1]</nmts>
                <thermostat mode='pile_l'>
                    <tau>10</tau>
                    <pile_lambda>0.5</pile_lambda>
                </thermostat>
            </dynamics>
        </motion>
        <ensemble>
            <temperature>300</temperature>
        </ensemble>
    </system>
</simulation>
